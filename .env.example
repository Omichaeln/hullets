# Huletts promotion platform — configuration reference (names and descriptions only; never commit values).
# Generated from packages/core/src/config.ts (CONFIG_DOC) by tools/gen-env-example.ts. Secrets are marked [secret].

# local | test | staging | production. Recorded in the database on first migration; production enables activation gates and refuses simulators.
ENVIRONMENT=local

# PostgreSQL 16 connection string (one database per environment).
DATABASE_URL=postgres://promo:promo@127.0.0.1:5432/promo

# Maximum PostgreSQL connections for this process; size separately for API and worker services.
DB_POOL_MAX=10

# PostgreSQL statement timeout.
DB_STATEMENT_TIMEOUT_MS=30000

# PostgreSQL connection acquisition timeout.
DB_CONNECTION_TIMEOUT_MS=5000

# Bind address (0.0.0.0 on a PaaS).
HOST=127.0.0.1

# HTTP port for API, webhook and console.
PORT=8080

# Public HTTPS origin of this service (webhook URL, console links).
PUBLIC_BASE_URL=

# Comma-separated browser origins allowed to call the API cross-origin. Empty (default) when the API serves the console itself.
CORS_ORIGINS=

# Maximum concurrent webhook/tRPC requests per API replica before load shedding.
HTTP_MAX_IN_FLIGHT=200

# Number of trusted reverse proxies in front of this service. Sets how much of X-Forwarded-For is believed; 0 disables the header entirely. Never set it higher than the real hop count: everything beyond it is client-supplied.
TRUSTED_PROXY_HOPS=1

# Maximum tRPC request body. The simulator upload route has its own larger limit.
HTTP_JSON_LIMIT=512kb

# Maximum body for the staff simulator upload route (non-production).
HTTP_UPLOAD_LIMIT=20mb

# Private receipt media root (filesystem adapter). Never inside the web root.
MEDIA_ROOT=./data/media

# fs | s3 (S3-compatible bucket via S3_* variables).
STORAGE_DRIVER=fs

# Bucket for STORAGE_DRIVER=s3.
S3_BUCKET=

# Object-key prefix for receipt media.
S3_PREFIX=media

# S3-compatible endpoint (optional).
S3_ENDPOINT=

# Bucket region.
S3_REGION=us-east-1

# Storage credential. [secret]
S3_ACCESS_KEY_ID=

# Storage credential. [secret]
S3_SECRET_ACCESS_KEY=

# First technical administrator (created once, must change password).
BOOTSTRAP_ADMIN_EMAIL=

# Temporary password for the bootstrap administrator (>= 14 chars). [secret]
BOOTSTRAP_ADMIN_PASSWORD=

# Key material for field-level encryption (identity numbers, MFA secrets). Required outside local. [secret]
DATA_KEY=

# HMAC key for signed audit checkpoints exported in draw bundles. [secret]
AUDIT_SIGNING_KEY=

# Staff session lifetime in hours.
SESSION_HOURS=12

# Country code prefixed to local phone numbers (test assumption; D-04).
DEFAULT_COUNTRY_CODE=263

# cloud-api (Meta WhatsApp Business Platform) | simulator (TEST ONLY; refused in production).
WHATSAPP_PROVIDER=simulator

# Graph API version.
META_GRAPH_VERSION=v21.0

# Cloud API phone number id.
META_PHONE_NUMBER_ID=

# WhatsApp Business Account id.
META_WABA_ID=

# System-user access token. [secret]
META_ACCESS_TOKEN=

# App secret for X-Hub-Signature-256 verification. [secret]
META_APP_SECRET=

# Webhook verification token. [secret]
META_VERIFY_TOKEN=

# Comma-separated designated test recipients; when set (non-production), messages to other numbers are held.
OUTBOUND_ALLOWLIST=

# anthropic (vision model, real, needs key) | tesseract (real, offline OCR) | anthropic+tesseract (vision with local cross-check) | simulator (TEST ONLY; refused outside local/test).
EXTRACTOR=tesseract

# Anthropic API key for the vision extractor. [secret]
ANTHROPIC_API_KEY=

# Vision model id.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional API base override.
ANTHROPIC_BASE_URL=

# Per-image extraction timeout.
EXTRACTION_TIMEOUT_MS=45000

# none | zimra-fdms (validate fiscal receipts against ZIMRA FDMS via FISCAL_BASE_URL) | simulator (TEST ONLY; refused outside local/test).
FISCAL_PROVIDER=none

# HTTPS validation endpoint for fiscal receipts. Its host must also appear in FISCAL_ALLOWED_HOSTS.
FISCAL_BASE_URL=

# Bearer token for the fiscal validation endpoint, when one is required. [secret]
FISCAL_API_KEY=

# REQUIRED comma-separated host allowlist for fiscal lookups. Empty means fiscal verification is not configured and every receipt takes the OCR path; it never means 'any host'.
FISCAL_ALLOWED_HOSTS=

# Treat an unavailable fiscal provider as a readiness failure. Leave false to degrade to OCR rather than stop intake.
FISCAL_REQUIRED=false

# Per-hop HTTPS timeout for a fiscal validation request.
FISCAL_TIMEOUT_MS=8000

# Maximum fiscal validation response size.
FISCAL_MAX_BYTES=1000000

# Maximum HTTPS redirect hops for a fiscal validation request.
FISCAL_MAX_REDIRECTS=3

# Shape of the FDMS validation response: html (the real ZIMRA verification page, reached through its 'Review Invoice' form) | json (a structured body, e.g. a vendor gateway). A JSON body is mapped as JSON whichever is set; this decides only whether an HTML page is read or refused.
FISCAL_CONTRACT_MODE=html

# Widths of the packed ZIMRA QR tail: deviceId,fiscalDayNo,receiptGlobalNo,verificationCode. Confirm against the published FDMS specification before production; a wrong width mis-identifies every receipt.
FISCAL_QR_LAYOUT=10,4,10,16

# Run advisory AI receipt verification after deterministic extraction.
AI_VERIFICATION_ENABLED=false

# Treat missing AI verification as a hold/review condition.
AI_VERIFICATION_REQUIRED=false

# openai | anthropic provider used for receipt verification.
AI_VERIFICATION_PROVIDER=openai

# Vision model used for receipt verification.
AI_VERIFICATION_MODEL=gpt-4o-mini

# OpenAI API key for receipt verification. [secret]
OPENAI_API_KEY=

# Optional OpenAI-compatible API base override.
OPENAI_BASE_URL=

# AI verification request timeout.
AI_VERIFICATION_TIMEOUT_MS=60000

# Uncalibrated model signal below this value is held for review; it is not a calibrated probability.
AI_VERIFICATION_MIN_PROBABILITY=0.98

# none | http-contract (generic JSON contract; see docs/integrations/crm.md) — vendor adapter is a client decision (D-19).
CRM_PROVIDER=none

# Base URL of the CRM contract endpoint.
CRM_BASE_URL=

# Bearer token for the CRM endpoint. [secret]
CRM_TOKEN=

# CRM call timeout.
CRM_TIMEOUT_MS=10000

# Review service target used for queue ageing and alerts (test value; D-14).
REVIEW_SLA_HOURS=24

# Winner claim deadline after notification (test value; D-17).
CLAIM_WINDOW_DAYS=7

# Raw receipt image retention (D-22 pending).
RETENTION_MEDIA_DAYS=90

# embedded (worker loop inside the API process) | external (run `npm run worker` separately) | off.
WORKER_MODE=embedded

# Worker poll interval.
WORKER_POLL_MS=1500

# Maximum inbound events claimed per worker tick.
WORKER_EVENT_BATCH=25

# Maximum jobs claimed per worker tick.
WORKER_JOB_BATCH=10

# pino log level.
LOG_LEVEL=info

# Non-production only: seed the sample campaign on start if absent.
SEED_ON_BOOT=false
