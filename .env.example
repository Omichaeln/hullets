# Huletts promotion platform — configuration reference (names and descriptions only; never commit values).
# Generated from packages/core/src/config.ts (CONFIG_DOC). Secrets are marked [secret].

# local | test | staging | production. Recorded in the database on first migration; production enables activation gates and refuses simulators.
ENVIRONMENT=local

# PostgreSQL 16 connection string (one database per environment).
DATABASE_URL=postgres://promo:promo@127.0.0.1:5432/promo

# Per-process pool and timeout controls; size API and worker independently.
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Bind address (0.0.0.0 on a PaaS).
HOST=127.0.0.1

# HTTP port for API, webhook and console.
PORT=8080

# Public HTTPS origin of this service (webhook URL, console links).
PUBLIC_BASE_URL=
# Comma-separated browser origins allowed to call the API cross-origin. Empty (default) when the API serves the console itself.
CORS_ORIGINS=

# Per-replica load shedding for webhook and tRPC work.
HTTP_MAX_IN_FLIGHT=200

# Private receipt media root (filesystem adapter). Never inside the web root.
MEDIA_ROOT=./data/media

# fs | s3 (S3-compatible bucket via S3_* variables).
STORAGE_DRIVER=fs

# Bucket for STORAGE_DRIVER=s3.
S3_BUCKET=

# Object-key prefix for receipt media.
S3_PREFIX=media

# S3-compatible endpoint (optional).
S3_ENDPOINT=

# Bucket region.
S3_REGION=us-east-1

# Storage credential. [secret]
S3_ACCESS_KEY_ID=

# Storage credential. [secret]
S3_SECRET_ACCESS_KEY=

# First technical administrator (created once, must change password).
BOOTSTRAP_ADMIN_EMAIL=

# Temporary password for the bootstrap administrator (>= 14 chars). [secret]
BOOTSTRAP_ADMIN_PASSWORD=

# Key material for field-level encryption (identity numbers, MFA secrets). Required outside local. [secret]
DATA_KEY=

# HMAC key for signed audit checkpoints exported in draw bundles. [secret]
AUDIT_SIGNING_KEY=

# Staff session lifetime in hours.
SESSION_HOURS=12

# Country code prefixed to local phone numbers (test assumption; D-04).
DEFAULT_COUNTRY_CODE=263

# cloud-api (Meta WhatsApp Business Platform) | simulator (TEST ONLY; refused in production).
WHATSAPP_PROVIDER=simulator

# Graph API version.
META_GRAPH_VERSION=v21.0

# Cloud API phone number id.
META_PHONE_NUMBER_ID=

# WhatsApp Business Account id.
META_WABA_ID=

# System-user access token. [secret]
META_ACCESS_TOKEN=

# App secret for X-Hub-Signature-256 verification. [secret]
META_APP_SECRET=

# Webhook verification token. [secret]
META_VERIFY_TOKEN=

# Comma-separated designated test recipients; when set (non-production), messages to other numbers are held.
OUTBOUND_ALLOWLIST=

# anthropic (vision model, real, needs key) | tesseract (real, offline OCR) | anthropic+tesseract (vision with local cross-check) | simulator (TEST ONLY; refused outside local/test).
EXTRACTOR=tesseract

# Anthropic API key for the vision extractor. [secret]
ANTHROPIC_API_KEY=

# Vision model id.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional API base override.
ANTHROPIC_BASE_URL=

# Per-image extraction timeout.
EXTRACTION_TIMEOUT_MS=45000

# none | http-contract (generic JSON contract; see docs/integrations/crm.md) — vendor adapter is a client decision (D-19).
CRM_PROVIDER=none

# Base URL of the CRM contract endpoint.
CRM_BASE_URL=

# Bearer token for the CRM endpoint. [secret]
CRM_TOKEN=

# CRM call timeout.
CRM_TIMEOUT_MS=10000

# Review service target used for queue ageing and alerts (test value; D-14).
REVIEW_SLA_HOURS=24

# Winner claim deadline after notification (test value; D-17).
CLAIM_WINDOW_DAYS=7

# Raw receipt image retention (D-22 pending).
RETENTION_MEDIA_DAYS=90

# embedded (worker loop inside the API process) | external (run `npm run worker` separately) | off.
WORKER_MODE=embedded

# External worker tuning.
WORKER_POLL_MS=1500
WORKER_EVENT_BATCH=25
WORKER_JOB_BATCH=10

# pino log level.
LOG_LEVEL=info

# Non-production only: seed the sample campaign on start if absent.
SEED_ON_BOOT=false
